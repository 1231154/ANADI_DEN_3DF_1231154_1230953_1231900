\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Per-fold weighted F1 distributions for the Neural Network and Decision Tree (classification). The Neural Network scores higher in every fold. Paired $t$-test: $t = 8.272$, $p < 0.001$.}}{6}{}\protected@file@percent }
\newlabel{fig:stat_cls}{{8}{6}{}{figure.8}{}}
