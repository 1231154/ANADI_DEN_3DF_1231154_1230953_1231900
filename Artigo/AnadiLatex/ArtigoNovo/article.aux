\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Feature importance for the Decision Tree classifier. \textit  {Left:} Gini-based importance; \texttt  {Cap\_per\_Cliente} (0.658) and \texttt  {PContratada\_per\_Cliente} (0.222) jointly account for 88\% of splitting power. \textit  {Right:} Pearson correlation of each feature with \texttt  {Util\_Decimal}, confirming that the most important features are those most linearly associated with the target variable.}}{8}{}\protected@file@percent }
\newlabel{fig:feat_imp}{{6}{8}{}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Learning curves for the best (Neural Network, left) and worst (KNN $K$=10, right) classification models (5-fold CV, 12,000-record subsample). The Neural Network converges with a narrow train--validation gap. KNN plateaus at a lower level regardless of data volume, pointing to a structural limitation rather than a data deficiency.}}{8}{}\protected@file@percent }
\newlabel{fig:lc_cls}{{7}{8}{}{figure.7}{}}
