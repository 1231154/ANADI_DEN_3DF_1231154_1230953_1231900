    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Categorias agrupadas em \"Outros\" (< 2% = < 1441 PTDs):\n",
      "  - Cabine subterrânea: 842 PTDs (1.17%)\n",
      "  - Cabine metálica (monobloco): 533 PTDs (0.74%)\n",
